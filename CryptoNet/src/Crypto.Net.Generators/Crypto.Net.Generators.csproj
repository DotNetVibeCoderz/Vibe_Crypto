<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Source generators run inside the compiler, which requires netstandard2.0. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <Description>Source generators for Crypto.Net: Solidity ABI JSON (*.abi.json, Hardhat/Foundry artifacts) becomes a typed EvmContract client, and Anchor IDL (*.idl.json) becomes a Solana instruction/account client. The same code generator powers `cnet gen`.</Description>
    <PackageTags>$(PackageTags);source-generator;abi;anchor;idl;codegen</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128;RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="build\Crypto.Net.Generators.props" Pack="true" PackagePath="build;buildTransitive" />
  </ItemGroup>
</Project>
