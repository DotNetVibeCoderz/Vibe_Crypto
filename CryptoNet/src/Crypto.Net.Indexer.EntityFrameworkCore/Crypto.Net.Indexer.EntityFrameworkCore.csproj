    <PackageTags>$(PackageTags);indexer;efcore;sqlite</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Crypto.Net.Indexer\Crypto.Net.Indexer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
  </ItemGroup>
</Project>
